{
  "name": "youtube-auto-pusher",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube Auto Pusher V1.0 by OSN OCIF — Tự động đăng video YouTube đa kênh",
  "author": "OSN OCIF",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64",
    "obfuscate": "node obfuscate.js",
    "restore": "node obfuscate.js restore"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.osnocif.youtube-auto-pusher",
    "productName": "YouTube Auto Pusher",
    "copyright": "Copyright © 2026 OSN OCIF",
    "publish": [{
      "provider": "github",
      "owner": "Cofi295",
      "repo": "youtube-auto-pusher"
    }],
    "directories": {
      "output": "..\\release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..\\dist\\api_server.exe",
        "to": "backend\\api_server.exe"
      },
      {
        "from": "assets\\app-icon.jpg",
        "to": "assets\\app-icon.jpg"
      }
    ],
    "win": {
      "icon": "assets\\app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube Auto Pusher",
      "installerIcon": "assets\\app-icon.ico",
      "uninstallerIcon": "assets\\app-icon.ico",
      "installerHeaderIcon": "assets\\app-icon.ico",
      "license": "LICENSE.txt",
      "installerLanguages": [
        "en_US",
        "vi_VN"
      ],
      "deleteAppDataOnUninstall": false,
      "menuCategory": "YouTube Tools"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
